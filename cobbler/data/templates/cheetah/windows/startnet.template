wpeinit

$SNIPPET('built-in-wait_network_online')
#set $distros_dir = '\\\\' + $http_server + '\\' + $samba_distro_share
#set $distro_share = 'Z:\\links\\' + $distro_name
## Windows 10 1709+/11 refuse guest/anonymous SMB sessions by default (surfaced as "System error
## 53: network path not found" rather than an access-denied error), which breaks the guest-accessible
## Samba share documented in docs/user-guide/wingen.rst. If the server was configured with a Samba
## account for the share named by the "samba_distro_share" setting (see smbpasswd(8)), set
## "samba_distro_user"/"samba_distro_password" in autoinstall_meta to authenticate instead of relying
## on the guest fallback Windows blocks by default -- no credential is baked into this template.
## wpeinit/the network check above only confirm ICMP reachability, not that the SMB redirector has
## finished its own, separately-timed negotiate/session-setup handshake -- in practice "net use"
## can still fail with "System error 53: network path not found" on its first attempt immediately
## after boot even though the exact same command succeeds moments later with no other change
## (confirmed live: the server-side session/file leases showed a fully successful, authenticated
## connection establishing within a couple of seconds of a "net use" call that had already reported
## failure to this script). Retry a few times with a short delay rather than failing on one
## transient attempt.
set net_use_retry=0
:NET_USE_RETRY
#if "samba_distro_user" in $autoinstall_meta and "samba_distro_password" in $autoinstall_meta
net use z: $distros_dir /user:$autoinstall_meta["samba_distro_user"] $autoinstall_meta["samba_distro_password"]
#else
net use z: $distros_dir
#end if
set exit_code=%ERRORLEVEL%
IF %exit_code% EQU 0 GOTO INSTALL
set /a net_use_retry=%net_use_retry%+1
IF %net_use_retry% GEQ 5 GOTO NET_USE_FAILED
ping -n 3 127.0.0.1 >nul
GOTO NET_USE_RETRY
:NET_USE_FAILED
echo "Can't mount network drive"
pause
goto EXIT

:INSTALL
#if $os_version in ('xp', '2003' )
#if "clean_disk" in $autoinstall_meta
echo select disk 0 >disk.scr
echo clean >>disk.scr
echo create partition primary >>disk.scr
echo select partition 1 >>disk.scr
echo active >>disk.scr
echo format fs=ntfs quick >>disk.scr
echo assign letter=C >>disk.scr
diskpart.exe /s disk.scr
bootsect.exe /nt52 c: /force /mbr
#end if
xcopy $distro_share\\$OEM\$\\$1 c: /y /s /e
#end if
#set $unattended = ""
#if "answerfile" in $autoinstall_meta
## Pass the answer file as a full UNC path rather than a Z:-mapped one: drive letter mappings are
## per-session, and setup.exe relaunching itself in a different session during its own startup
## (a well-documented behavior) silently loses the mapping, making Setup fall back to its fully
## interactive flow with no indication the switch was ever ignored.
#set $unattended = "/unattend:" + $distros_dir + '\\images\\' + $distro_name + '\\' + $autoinstall_meta["answerfile"]
#end if

#if $os_version in ('xp', '2003' )
#if $arch == 'x86_64'
        #set $win_arch = 'amd64'
#else if $arch == 'i386'
        #set $win_arch = 'i386'
#end if
#set $winnt = $distro_share + '\\' + $win_arch + '\\winnt32.exe'
$winnt /syspart:c: /tempdrive:c: /makelocalsource $unattended
#else
## Windows 11's TPM 2.0/Secure Boot/CPU-family hardware checks reject most VMs outright ("Windows 11
## cannot run on this PC"), aborting the install before it reaches any unattend-driven step. Set
## "bypass_win11_requirements" (any value) in autoinstall_meta to apply the LabConfig registry bypass
## Microsoft itself documents for exactly this case (VMs, unsupported-but-functional hardware).
#if "bypass_win11_requirements" in $autoinstall_meta
reg add "HKLM\SYSTEM\Setup\LabConfig" /v BypassTPMCheck /t REG_DWORD /d 1 /f
reg add "HKLM\SYSTEM\Setup\LabConfig" /v BypassSecureBootCheck /t REG_DWORD /d 1 /f
reg add "HKLM\SYSTEM\Setup\LabConfig" /v BypassRAMCheck /t REG_DWORD /d 1 /f
reg add "HKLM\SYSTEM\Setup\LabConfig" /v BypassStorageCheck /t REG_DWORD /d 1 /f
reg add "HKLM\SYSTEM\Setup\LabConfig" /v BypassCPUCheck /t REG_DWORD /d 1 /f
#end if
## Unlike every other breed, Windows has never had a "pxe_just_once" hook: setup.exe's first WinPE
## phase normally reboots the VM on its own to continue installing from the local disk, and
## without disabling netboot first, the VM just re-PXE-boots back into WinPE and re-runs this
## entire script from scratch -- including WillWipeDisk=true -- a destructive reinstall loop
## rather than a cosmetic nuisance. Calling nopxe is deliberately sequenced *after* setup.exe
## returns successfully, not before it starts: disabling netboot pre-emptively would strand a
## system whose install then fails/crashes with no way to retry via PXE, exactly the failure mode
## every other breed's %post-triggered nopxe call already avoids by running after the real work is
## done. "/noreboot" plus an explicit "wpeutil reboot" afterwards gives us that window to check
## setup.exe's own exit code before deciding whether continuing past this point is even safe.
## The installation media's boot.wim is a minimal WinPE with neither curl nor PowerShell
## (confirmed via `wimdir`); unlike certutil (also absent here -- it ships with full Windows, not
## every WinPE build), WSH (cscript.exe) and WinHTTP (winhttp.dll) are part of boot.wim's base
## scripting/networking components, so a tiny generated VBScript is the most portable way to issue
## the GET request.
#set $system_name = $getVar('system_name', '')
#set $noreboot = ""
#if $system_name != '' and $getVar('pxe_just_once', '')
#set $noreboot = " /noreboot"
#end if
$distro_share\sources\setup.exe $unattended$noreboot
#if $noreboot != ""
set setup_exit_code=%ERRORLEVEL%
IF %setup_exit_code% NEQ 0 (
    echo "setup.exe exited with code %setup_exit_code%; leaving netboot enabled for a retry"
    goto EXIT
)
#set $nopxe_url = $getVar('autoinstall_scheme', 'http') + '://' + $http_server + '/cblr/svc/op/nopxe/system/' + $system_name
echo Set http = CreateObject("WinHttp.WinHttpRequest.5.1") > nopxe.vbs
echo http.Open "GET", "$nopxe_url", False >> nopxe.vbs
echo http.Send >> nopxe.vbs
cscript //nologo //b nopxe.vbs
wpeutil reboot
#end if
#end if
:EXIT
exit
