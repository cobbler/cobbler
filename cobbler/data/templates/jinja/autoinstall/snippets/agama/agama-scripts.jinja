{#- https://agama-project.github.io/docs/user/reference/profile/scripts -#}
{#- Cobbler Agama Snippets shall be 4 spaces indented and should not contain a final comma -#}
{#- Each entry in a stage's list may be a plain string (an autoinstall-file name fetched via Cobbler's own
   file-serving endpoint, the original behavior) or a full script object (name/content/url/chroot, serialized
   as-is) -- the latter lets AgamaGenerator merge in Cobbler's built-in "nopxe" post-script alongside whatever
   scripts the admin already configured here, rather than emitting a second, JSON-breaking "scripts" key. -#}
{%- if agama_scripts is defined %}
    "scripts": {
    {%- for stage, stage_scripts in agama_scripts.items() %}
        "{{ stage }}": [
        {%- for script in stage_scripts %}
            {%- if script is mapping %}
            {{ script | tojson }}{{ "," if not loop.last }}
            {%- else %}
            {
                "name": "{{ script }}",
                "url": "{{ autoinstall_scheme}}://{{ server }}/cblr/svc/op/autoinstall/{{ obj_type }}/{{ name }}/filename/{{ script }}"
            }{{ "," if not loop.last }}
            {%- endif %}
        {%- endfor%}
        ]{{ "," if not loop.last }}
    {%- endfor %}
    }
{%- endif %}